# Compass — connector + server configuration.
# Copy to `.env` and fill in what you have. Any connector with no credentials falls back
# to its synthetic mock, so partial configuration is fine — each source goes live the
# moment its credentials are present. See docs/CONNECTORS.md for how to obtain each value.

# ─────────────────────────────────────────────────────────────────────────────
# GivingData  (grants system of record)
# ─────────────────────────────────────────────────────────────────────────────
# GIVINGDATA_BASE_URL=https://api.givingdata.com/v1      # confirm exact URL in discovery (question G1)
# GIVINGDATA_API_KEY=
# GIVINGDATA_RECORD_URL=https://app.givingdata.com/records/
# GIVINGDATA_FIELD_MAP={"projectedNorthStar":"ns_ratio_v3"}   # optional: remap field names once G6–G13 are answered

# ─────────────────────────────────────────────────────────────────────────────
# Google Drive  (narrative reports + internal notes)
# ─────────────────────────────────────────────────────────────────────────────
# One of these two — the service-account key JSON, inline or as a file path:
# GOOGLE_SA_KEY_JSON={"client_email":"...","private_key":"..."}
# GOOGLE_SA_KEY_FILE=./secrets/compass-drive-sa.json
# GOOGLE_DRIVE_IDS=0AH...,0AJ...                          # the Shared Drive ids to ingest (question D4)
# GOOGLE_SUBJECT=service-reader@gitlabfoundation.org      # only if using domain-wide delegation

# ─────────────────────────────────────────────────────────────────────────────
# Airtable  (relationship CRM)
# ─────────────────────────────────────────────────────────────────────────────
# AIRTABLE_TOKEN=pat...                                   # read-only personal access token (question A2)
# AIRTABLE_BASE_ID=app...
# AIRTABLE_TABLES=Organizations,Contacts,Interactions
# AIRTABLE_TIER_MAP={"Interactions":"programs-only","Donors":"restricted"}

# ─────────────────────────────────────────────────────────────────────────────
# Zoom  (Team Chat + recorded-call archive) — OFF by default; governance opt-in required
# ─────────────────────────────────────────────────────────────────────────────
# COMPASS_ZOOM_ENABLE=true                # explicit opt-in on top of credentials (Z8–Z12)
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=                         # a Server-to-Server OAuth app
# ZOOM_CLIENT_SECRET=
# ZOOM_CHAT_FROM=2021-02-01               # earliest date to pull (clamped to real retention)
# ZOOM_CHANNELS=Programs,AI Fund          # optional allowlist — public channels only
# ZOOM_ARCHIVE=true                       # also pull recorded-call transcripts + chat (staged as restricted)

# ─────────────────────────────────────────────────────────────────────────────
# Sign-in  (Google OAuth — one client registered in Google Cloud console)
# ─────────────────────────────────────────────────────────────────────────────
# COMPASS_OAUTH_CLIENT_ID=
# COMPASS_OAUTH_CLIENT_SECRET=
# COMPASS_OAUTH_REDIRECT_URI=https://compass.gitlabfoundation.org/auth/callback
# COMPASS_HD=gitlabfoundation.org
# COMPASS_SESSION_SECRET=                                 # long random string; `openssl rand -hex 32`
# COMPASS_ALLOWED_EMAILS=a@x.org,b@x.org                  # optional: scope a pilot/demo to named people
# COMPASS_NO_DEMO=1                                       # production: turn the demo persona switch OFF

# Group → tier resolution:
# COMPASS_GROUP_MAP={"someone@gitlabfoundation.org":["programs"]}   # demo / dev fallback
# GOOGLE_DIRECTORY_SUBJECT=admin@gitlabfoundation.org     # production: an admin to impersonate for the read-only
#                                                          Admin SDK Directory lookup (reuses GOOGLE_SA_KEY_*)
# COMPASS_DIRECTORY_ACTIVE_CHECK=1                        # also reject a suspended/archived account at sign-in
# COMPASS_DIRECTORY_TTL_SEC=300                           # group-membership cache TTL

# ─────────────────────────────────────────────────────────────────────────────
# Egress allowlist  (OWASP A10 — the in-process backstop; network policy is primary)
# ─────────────────────────────────────────────────────────────────────────────
# COMPASS_EGRESS_ENFORCE=1                                # block outbound fetch to anything off the allowlist
# COMPASS_EGRESS_ALLOW=extra-host.example.com             # additional hosts (connector/IdP hosts are auto-added)

# ─────────────────────────────────────────────────────────────────────────────
# Audit
# ─────────────────────────────────────────────────────────────────────────────
# COMPASS_AUDIT_LOG=dist/audit.jsonl                      # local hash-chained log path
# COMPASS_AUDIT_WEBHOOK=https://siem.example.org/ingest   # also stream each record off-host

# ─────────────────────────────────────────────────────────────────────────────
# Answers  (optional — written synthesis instead of the extractive evidence brief)
# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=                                      # only under a zero-retention agreement (question X3)

# PORT=8787

# COMPASS_TRANSLATE = mt | api | glossary — render non-English docs into English at intake
# COMPASS_TRANSLATE=mt            # local opus-mt via transformers.js (~300MB, no key)
# COMPASS_TRANSLATE_URL=          # a translation API endpoint (with COMPASS_TRANSLATE=api)
# COMPASS_TRANSLATE_KEY=
