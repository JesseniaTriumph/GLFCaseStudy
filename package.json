{
  "name": "compass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Compass — a permission-aware way to ask years of grant knowledge one question. Modular ingest → clean → dedupe → resolve → index → retrieve → cite pipeline with swappable source adapters.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:index": "tsx scripts/build-index.ts",
    "eval": "tsx scripts/eval.ts",
    "security": "tsx scripts/security-check.ts",
    "audit": "tsx scripts/audit.ts",
    "ask": "tsx scripts/ask.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm run build:index && npm --prefix web run build",
    "typecheck": "tsc --noEmit",
    "eval:pg": "tsx scripts/eval-pg.ts",
    "build:index:embed": "tsx scripts/build-index.ts --embed bge-small",
    "eval:embed": "COMPASS_EMBED=bge-small tsx scripts/eval.ts",
    "serve": "tsx scripts/serve.ts",
    "server:check": "tsx scripts/server-check.ts",
    "redteam": "tsx scripts/redteam.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@huggingface/transformers": "^4.2.0"
  }
}
